# Instagram feed for the "Latest insights" section (optional).
# Long-lived access token from the Instagram API with Instagram Login
# (Meta developer app, Business/Creator account). Leave empty to show the
# built-in articles instead. Tokens last 60 days; see README for renewal.
INSTAGRAM_ACCESS_TOKEN=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX.
# Analytics only loads when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
